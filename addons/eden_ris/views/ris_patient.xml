<?xml version="1.0"?>
<odoo>
    <record id="ris_patient_form_view" model="ir.ui.view">
        <field name="name">Patient</field>
        <field name="model">ris.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}" on_change="1" field_id="image_1920_0"/>
                    <div class="oe_title">
                        <!-- <label for="name" string="Patient's Name"/> -->
                        <h1>
                            <div class="d_flex">
                                <field class="text-break" name="name" readonly="1" options="{'line_breaks': False}" widget="text" placeholder="Por ejemplo, hamburguesa de queso" on_change="1" field_id="name_0"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ref" string="Med. Record Number" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Information">
                            <group>
                                <field name="name"/>
                                <field name="birth_date"/>
                                <field name="gender"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ris_patient_act" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">ris.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_is_patient': True}</field>
    </record>
    <menuitem id="ris_patient_menu" name="Patients" parent="settings_root_menu" action="ris_patient_act"/>
</odoo>
